{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "uk.novaroma-homelab.season-themes",
  "Name": "Novaroma Season Themes",
  "Version": "1.0.0.0",
  "Author": "JestingDart4369",
  "Description": "Seasonal colour themes for your keys and the Stream Deck Neo infobar: follow or set the season, switch light and dark, launcher keys, study timer, clock, countdown, server status and page indicators.",
  "Category": "Novaroma Season Themes",
  "CategoryIcon": "imgs/category",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "7.6"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "uk.novaroma-homelab.season-themes.season",
      "Name": "Season",
      "Tooltip": "Cycle, set or follow the season",
      "Icon": "imgs/actions/season",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/states/season"
        }
      ],
      "PropertyInspectorPath": "ui/season.html"
    },
    {
      "UUID": "uk.novaroma-homelab.season-themes.theme",
      "Name": "Theme",
      "Tooltip": "Switch between light, dark and automatic",
      "Icon": "imgs/actions/theme",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/states/theme"
        }
      ],
      "PropertyInspectorPath": "ui/theme.html"
    },
    {
      "UUID": "uk.novaroma-homelab.season-themes.launcher",
      "Name": "Launcher",
      "Tooltip": "Open a link or app in the season colours",
      "Icon": "imgs/actions/launcher",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/states/launcher"
        }
      ],
      "PropertyInspectorPath": "ui/launcher.html"
    },
    {
      "UUID": "uk.novaroma-homelab.season-themes.timer",
